{
    "dataRoles": [
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Y-axis (bars)",
            "name": "measure",
            "kind": "Measure"
        },
        {
            "displayName": "Markers",
            "name": "marker",
            "kind": "Measure"
        }
    ],
    "objects": {
        "dataPoint": {
            "displayName": "Bar colors",
            "properties": {
                "fill": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "displayName": "Bar layout",
            "properties": {
                "stacked": {
                    "displayName": "Stacked",
                    "type": {
                        "bool": true
                    }
                },
                "barPadding": {
                    "displayName": "Bar padding",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "marker": {
            "displayName": "Markers",
            "properties": {
                "show": {
                    "displayName": "Show markers",
                    "type": {
                        "bool": true
                    }
                },
                "shape": {
                    "displayName": "Shape",
                    "type": {
                        "enumeration": [
                            { "value": "circle", "displayName": "Circle" },
                            { "value": "square", "displayName": "Square" },
                            { "value": "triangle", "displayName": "Triangle" },
                            { "value": "diamond", "displayName": "Diamond" },
                            { "value": "cross", "displayName": "Cross" },
                            { "value": "star", "displayName": "Star" },
                            { "value": "line", "displayName": "Line" }
                        ]
                    }
                },
                "size": {
                    "displayName": "Size",
                    "type": {
                        "numeric": true
                    }
                },
                "color": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "categoryAxis": {
            "displayName": "Category axis (Y)",
            "properties": {
                "show": {
                    "displayName": "Show",
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "displayName": "Text size",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontColor": {
                    "displayName": "Font color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showTitle": {
                    "displayName": "Show axis title",
                    "type": {
                        "bool": true
                    }
                },
                "titleText": {
                    "displayName": "Axis title",
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "valueAxis": {
            "displayName": "Value axis (X)",
            "properties": {
                "show": {
                    "displayName": "Show",
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "displayName": "Text size",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "fontColor": {
                    "displayName": "Font color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showTitle": {
                    "displayName": "Show axis title",
                    "type": {
                        "bool": true
                    }
                },
                "titleText": {
                    "displayName": "Axis title",
                    "type": {
                        "text": true
                    }
                },
                "start": {
                    "displayName": "Start",
                    "type": {
                        "numeric": true
                    }
                },
                "end": {
                    "displayName": "End",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "legend": {
            "displayName": "Legend",
            "properties": {
                "show": {
                    "displayName": "Show",
                    "type": {
                        "bool": true
                    }
                },
                "position": {
                    "displayName": "Position",
                    "type": {
                        "enumeration": [
                            { "value": "Top", "displayName": "Top" },
                            { "value": "Bottom", "displayName": "Bottom" },
                            { "value": "Right", "displayName": "Right" }
                        ]
                    }
                },
                "fontSize": {
                    "displayName": "Text size",
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "measure": { "min": 0 },
                    "marker": { "min": 0, "max": 1 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {}
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": { "in": "measure" }
                        },
                        {
                            "bind": { "to": "marker" }
                        }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
